# ============================================================
# Copie este arquivo para ".env" (sem o ".example") e preencha
# com os valores reais do SEU ambiente. O ".env" nunca deve ir
# para o Git/GitHub (por isso ele já está no .gitignore).
# ============================================================

# --- Banco de dados ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meu_app
DB_USER=root
DB_PASS=

# --- Aplicacao ---
# APP_ENV: "development" mostra erros na tela (util para debugar).
#          Troque para "production" quando for publicar de verdade
#          (esconde os erros do usuario final).
APP_ENV=development

# APP_URL: o endereco COMPLETO ate a pasta "public" do projeto.
# Exemplos:
#   Servidor embutido do PHP  -> http://localhost:8000
#   WAMP/XAMPP numa subpasta  -> http://localhost/nome-da-pasta/public
APP_URL=http://localhost:8000

# APP_KEY: reservado para uso futuro (ex: assinar tokens, criptografar
# dados). Ainda nao e usado pelo codigo-base, mas already fica pronto
# para quando voce precisar. Gere uma string aleatoria de 32-64
# caracteres quando for usar.
APP_KEY=troque_esta_chave_por_uma_string_aleatoria_segura
